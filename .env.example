# Copia este archivo como .env y define un SESSION_SECRET real.
# Generarlo con: openssl rand -hex 32
SESSION_SECRET=

# OPCIONAL. Clave (mínimo 16 caracteres) con la que el servicio de gestión de datos
# convierte el DNI de capacitación en un código irreversible; el DNI no se guarda.
# Si se deja vacía, el servicio genera una automáticamente la primera vez y la guarda
# en la tabla DSLD_PARAMETROS. Si se cambia, hay que volver a importar el Excel.
DSLD_CLAVE_SEUDONIMO=
