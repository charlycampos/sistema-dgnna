} from 'lucide-react'
import { AppSidebar } from '@/components/app-sidebar'

// --- Tipos y Modelos ---
interface CargaItem {
  num: number
  den: number
  porcentaje?: number
}

interface IndicadorConfig {
  codigo: string
  nombre: string
  sub: string
  metaAnual: number | null
  habilitado: boolean
  cargas: Record<number, CargaItem>
}

type NivelClave = 'fav' | 'seg' | 'rie' | 'pen' | 'sm'

interface NivelEstilo {
  label: string
  bg: string
  fg: string
  dot: string
  bd: string
  cell: string
  cellFg: string
}

const NIVELES: Record<NivelClave, NivelEstilo> = {
  fav: {
    label: 'Avance favorable',
    bg: '#ECFDF5',
    fg: '#047857',
    dot: '#10B981',
    bd: '#A7F3D0',
