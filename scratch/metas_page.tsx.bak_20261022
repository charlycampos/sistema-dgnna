    sub: 'Acogimiento residencial · CAR Básico y Especializado',
    metaAnual: 80.13,
    habilitado: false,
    cargas: {}
  },
  {
    codigo: '4398',
    nombre: 'Adolescentes en CAR preparados para vida independiente',
    sub: 'Acogimiento residencial · Plan de vida independiente',
    metaAnual: 62.30,
    habilitado: false,
    cargas: {}
  },
  {
    codigo: '4399',
    nombre: 'NNA integrados en familia adoptiva',
    sub: 'Adopciones · Ubicación y designación familiar',
    metaAnual: 12.50,
    habilitado: false,
    cargas: {}
  },
  {
    codigo: '5138',
    nombre: 'Seguimiento post adoptivo oportuno',
    sub: 'Adopciones · Acompañamiento integral',
    metaAnual: 89.30,
    habilitado: false,
    cargas: {}
