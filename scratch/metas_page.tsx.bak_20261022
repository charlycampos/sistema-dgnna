    dot: '#F59E0B',
    bd: '#FDE68A',
    cell: '#FEF3C7',
    cellFg: '#92400E'
  },
  rie: {
    label: 'Riesgo de incumplimiento',
    bg: '#FFF1F2',
    fg: '#BE123C',
    dot: '#E11D48',
    bd: '#FECDD3',
    cell: '#FFE4E6',
    cellFg: '#9F1239'
  },
  pen: {
    label: 'Pendiente de carga',
    bg: '#F1F5F9',
    fg: '#475569',
    dot: '#94A3B8',
    bd: '#E2E8F0',
    cell: '#F8FAFC',
    cellFg: '#64748B'
  },
